        "required": false
      },
      {
        "id": "datetime_field",
        "name": "datetime",
        "type": "text",
        "required": false
      },
      {
        "id": "description_field",
        "name": "description",
        "type": "text",
        "required": false
      },
      {
        "id": "reported_by_field",
        "name": "reported_by",
        "type": "relation",
        "required": false,
        "options": {
          "collectionId": "_pb_users_auth_",
          "maxSelect": 1,
          "cascadeDelete": true
        }
      },
      {
        "id": "reported_by_name_field",
        "name": "reported_by_name",
        "type": "text",
        "required": false
      },
      {
        "id": "anonymous_field",
        "name": "anonymous",
        "type": "bool",
        "required": false,
        "options": {
          "default": false
        }
      },
      {
        "id": "evidence_field",
        "name": "evidence",
        "type": "json",
        "required": false
      },
      {
        "id": "lat_field",
        "name": "lat",
        "type": "number",
        "required": false
      },
      {
        "id": "lng_field",
        "name": "lng",
        "type": "number",
        "required": false
      },
      {
        "id": "status_field",
        "name": "status",
        "type": "select",
        "required": false,
        "options": {
          "values": ["Pending", "In Progress", "Resolved"],
          "maxSelect": 1,
          "default": "Pending"
        }
      },
      {
        "id": "assigned_to_field",
        "name": "assigned_to",
        "type": "relation",
        "required": false,
        "options": {
          "collectionId": "_pb_users_auth_",
          "maxSelect": 1,
          "cascadeDelete": false
        }
      }
    ]
  },
  {
    "id": "incident_timeline_collection",
