[
  {
    "id": "users_custom_fields",
    "name": "users",
    "type": "auth",
    "fields": [
      {
        "id": "role_field",
        "name": "role",
        "type": "select",
        "required": true,
        "options": {
          "values": ["student", "security", "coordinator", "admin"],
          "maxSelect": 1
        }
      },
      {
        "id": "department_field",
        "name": "department",
        "type": "text",
        "required": false
      },
      {
        "id": "approved_field",
        "name": "approved",
        "type": "bool",
        "required": false,
        "options": {
          "default": false
        }
      }
    ]
  },
  {
    "id": "incidents_collection",
    "name": "incidents",
