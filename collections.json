      },
      {
        "id": "user_name_field",
        "name": "user_name",
        "type": "text",
        "required": false
      },
      {
        "id": "action_field",
        "name": "action",
        "type": "text",
        "required": false
      },
      {
        "id": "notes_field",
        "name": "notes",
        "type": "text",
        "required": false
      }
